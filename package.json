    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "framer-motion": "^13.5.0",
